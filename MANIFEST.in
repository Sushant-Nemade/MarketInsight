include README.md LICENSE NOTICE.md pyproject.toml uv.lock Dockerfile compose.yaml .env.example
recursive-include MarketInsight *.py *.html *.json *.js *.css *.woff *.woff2 *.png *.txt *.md
recursive-include config *.py
recursive-include scripts *.py
recursive-include tests *.py
recursive-include docs *.md
recursive-include frontend/src *.ts *.tsx *.css
recursive-include frontend/public *.json *.png
include frontend/package.json frontend/package-lock.json frontend/vite.config.ts frontend/index.html frontend/playwright.config.ts frontend/tsconfig.json frontend/tsconfig.app.json frontend/tsconfig.node.json frontend/eslint.config.js frontend/.prettierrc.json
recursive-include frontend/tests *.ts
recursive-include frontend/scripts *.mjs
recursive-include .github/workflows *.yml
prune frontend/node_modules
prune frontend/test-results
prune build
prune data
global-exclude *.sqlite *.pem .env .env.production